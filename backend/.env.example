# ===================================
# Game Account Marketplace - Backend
# ===================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/game_marketplace?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-2026
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AES-256-GCM Encryption Key (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Bakong / Payment Gateway
BAKONG_API_KEY=your-bakong-api-key
BAKONG_WEBHOOK_SECRET=your-bakong-webhook-secret

# Cloudflare R2 / S3 Storage
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_BUCKET_NAME=game-marketplace-assets
S3_PUBLIC_URL=https://assets.yourdomain.com

# Platform Config
PLATFORM_COMMISSION_RATE=0.10
RESERVATION_TIMEOUT_MINUTES=15

# CORS
FRONTEND_URL=http://localhost:3000
